{
  "name": "ball-and-wall",
  "version": "1.1.0",
  "description": "Arkanoid style HTML5 game",
  "main": "index.html",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "vendor": "node scripts/vendor.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test:unit": "node --import ./tests/unit/setup.mjs --test \"tests/unit/*.test.mjs\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "test": "npm run lint && npm run test:unit && npm run build && npm run e2e"
  },
  "dependencies": {
    "fancyselect": "1.0.3",
    "jquery": "3.7.1",
    "js-md5": "0.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/budnix/ball-and-wall.git"
  },
  "author": "Krzysztof Budnik <budnix@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/budnix/ball-and-wall/issues"
  },
  "homepage": "https://github.com/budnix/ball-and-wall"
}

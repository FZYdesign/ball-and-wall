# Payment configuration. Copied to .env.dev and .env.prod on `npm install`;
# both are git-ignored. `npm run dev` reads .env.dev, `npm run build` reads
# .env.prod, so switching environments is a matter of which command you run --
# nothing is commented in or out by hand.
#
# scripts/env.mjs turns whichever file applies into js/_config_secrets.js, which
# the pages load. Anything left empty falls back to the defaults in
# js/_config_dev.js / js/_config_prod.js; with no API key the game uses the mock
# payment provider, which is why it runs, and the test suite passes, on a
# checkout with nothing filled in.
#
# ## Nothing here is secret
#
# These values are loaded by the browser and, in production, served from dist/.
# Keeping them out of the repository is not the same as keeping them secret:
# anyone who opens the page can read PAYMENT_SECRET_KEY, and a MoneyCollect
# secret key can create charges and issue refunds. Set PAYMENT_ORDER_ENDPOINT to
# a server of yours that holds the key and proxies MoneyCollect's create and
# status calls, and no secret needs to ship at all.

# moneycollect, or leave empty for the mock provider.
PAYMENT_PROVIDER=moneycollect

# test or pro. Must match the hosts below.
PAYMENT_MODE=test
PAYMENT_SDK_URL=https://test-static.moneycollect.com/jssdk/js/MoneyCollect.min.js
PAYMENT_SERVER_URL=https://test-api.moneycollect.com/api/services/v1/payment

# Publishable key (live_pu_… / test_pu_…) -- safe in the browser by design.
PAYMENT_API_KEY=

# Secret key (live_pr_… / test_pr_…). Read only when PAYMENT_ORDER_ENDPOINT is
# empty. Prefer leaving this blank and setting the endpoint instead.
PAYMENT_SECRET_KEY=

# Your own backend, e.g. https://api.example.com/payments. When set, the
# provider calls <endpoint>/create and <endpoint>/<paymentId> instead of
# MoneyCollect directly, and the secret key never reaches the browser.
PAYMENT_ORDER_ENDPOINT=

# Optional async notification URL for your backend.
PAYMENT_NOTIFY_URL=

# What the player is told they are buying, on the provider's own form.
PAYMENT_DESCRIPTION=Ball And Wall coins

# Sent with the card. Some acquirers decline a charge with no billing details.
# Placeholders until there is a player account to take them from.
PAYMENT_BILLING_EMAIL=
PAYMENT_BILLING_FIRST_NAME=Game
PAYMENT_BILLING_LAST_NAME=User
PAYMENT_BILLING_PHONE=
PAYMENT_BILLING_COUNTRY=US
PAYMENT_BILLING_STATE=NY
PAYMENT_BILLING_CITY=New York
PAYMENT_BILLING_LINE1=123 Main St
PAYMENT_BILLING_LINE2=
PAYMENT_BILLING_POSTAL_CODE=10001

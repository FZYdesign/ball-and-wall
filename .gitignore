# Editors / local tooling
.idea
.vscode/
*.swp
.claude/settings.local.json

# OS
.DS_Store

# Dependencies
node_modules/

# Payment configuration, per environment. Seeded from the committed .env.example
# by scripts/env.mjs; never committed. Keeping them out of git protects the
# repository, not the keys -- they are served to the browser. See .env.example
# for the way to avoid shipping a secret at all.
.env.dev
.env.prod
.env.local

# Generated from the environment file above by scripts/env.mjs.
js/_config_secrets.js

# Generated: `npm install` / `npm run vendor` recreates this from node_modules
vendor/

# Generated: `npm run build` recreates this
dist/

# Playwright output
test-results/
playwright-report/
blob-report/
.playwright/

# Snapshots and screenshots dropped by the MCP browser servers
.playwright-mcp/
